# eatme-back(apps/api) 환경변수 예시 — 비밀값 없음(placeholder).
# 사용법: 이 파일을 apps/api/.dev.env 로 복사한 뒤 값을 채운다.
#   cp apps/api/.env.example apps/api/.dev.env
# api는 .dev.env를 읽는다(ConfigModule envFilePath, prisma.config.ts). .dev.env는 커밋하지 않는다.
# 비밀값이 비어 있어도 서버는 부팅되고 해당 기능만 비활성(경고 로그)된다. 필수 항목은 [필수] 표시.

# --- DB ---
# [필수] PostgreSQL 연결 문자열
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/eatme

# --- JWT ---
# [필수] access token 서명 키(충분히 긴 임의 문자열)
JWT_SECRET=change-me-access-secret
# [필수] refresh token 서명 키(JWT_SECRET과 다른 값)
JWT_REFRESH_SECRET=change-me-refresh-secret

# --- URL ---
# API 자신의 공개 URL(OAuth 콜백 URL 생성, https면 nonce 쿠키 Secure). 운영은 https.
API_BASE_URL=http://localhost:4000
# 웹 오리진(정확한 origin — CORS 허용 대상 + OAuth 후 웹 리다이렉트 대상)
WEB_BASE_URL=http://localhost:3000
# 모바일 앱 딥링크 prefix(끝에 경로 구분자 포함). 기본 eatme://
MOBILE_REDIRECT_URI=eatme://

# --- 소셜 로그인 ---
# Google OAuth 2.0 클라이언트(리디렉션 URI: ${API_BASE_URL}/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 네이버 개발자센터 앱(Callback URL: ${API_BASE_URL}/auth/naver/callback)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Sign in with Apple ---
# identityToken aud 검증용 번들 ID(기본 com.eatme.app)
APPLE_BUNDLE_ID=com.eatme.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
# .p8 키 내용(줄바꿈은 \n 으로 이스케이프)
APPLE_PRIVATE_KEY=

# --- 보안 / rate-limit ---
# 프록시 신뢰 설정: false(기본) 또는 쉼표 구분 내부 프록시 CIDR/IP 목록(Next 서버·ingress/LB 주소).
# 신뢰 목록에 든 주소만 오른쪽부터 걷어내므로 클라이언트가 위조한 왼쪽 X-Forwarded-For 값은 무시된다.
# true 나 홉 수는 쓰지 말 것: 경로(웹 경유 / 모바일 직접)마다 홉 수가 달라 위조 IP를 믿게 될 수 있다.
TRUST_PROXY=false
# 인증 mutation(login/signup/appleLogin/linkSocialAccount) IP당 허용 횟수 / 창(ms)
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_MS=60000

# --- 푸시 ---
# Expo 푸시 API 액세스 토큰(Enhanced Security 사용 시)
EXPO_ACCESS_TOKEN=

# --- appConfig(모바일 강제 업데이트 / 스토어 링크) ---
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
IOS_STORE_URL=
ANDROID_STORE_URL=
SUPPORT_EMAIL=support@eatme.app

# --- 기타 ---
YOUTUBE_API_KEY=
# prisma/seed.ts가 만들 레시피 수(기본 100)
SEED_RECIPE_COUNT=100
