{
  "manifest_version": 3,
  "name": "냉부 — 쿠팡 주문내역 복사",
  "version": "0.1.0",
  "description": "쿠팡 주문내역 페이지에서 구매 품목을 추출해 클립보드로 복사합니다. (냉부 식재료 등록용)",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": [
    "https://mc.coupang.com/*",
    "https://*.coupang.com/*"
  ],
  "action": {
    "default_title": "냉부 주문내역 복사",
    "default_popup": "popup.html"
  }
}
